{
  "name": "nekostream",
  "version": "2026.4.1",
  "description": "A polished CLI for discovering and streaming anime from Vietnamese providers",
  "keywords": [
    "anime",
    "scraper",
    "animevietsub",
    "animetvn",
    "anime47",
    "nekostream",
    "cli",
    "video-player",
    "streaming",
    "vietsub",
    "anime-cli"
  ],
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "nekostream": "bin/nekostream.js"
  },
  "scripts": {
    "start": "tsx index.ts",
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx checks/search-check.mts",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pack:check": "node checks/package-check.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run pack:check",
    "prepublishOnly": "npm run check",
    "postinstall": "playwright install chromium"
  },
  "files": [
    "dist",
    "bin",
    "player-main.js",
    "player.html",
    "webview-preload.js",
    "isolate.js",
    "isolate.css"
  ],
  "dependencies": {
    "@electron/get": "^5.1.0",
    "@ghostery/adblocker-playwright": "^2.18.1",
    "@inquirer/prompts": "^8.5.2",
    "artplayer": "^5.3.0",
    "chalk": "^4.1.2",
    "cheerio": "^1.2.0",
    "cross-fetch": "^4.1.0",
    "discord-rpc": "^4.0.1",
    "electron": "^43.0.0",
    "eruda": "^3.4.3",
    "extract-zip": "^2.0.1",
    "hls.js": "^1.6.0",
    "ora": "^5.4.1",
    "playwright": "^1.61.1",
    "tsx": "^4.23.0",
    "undici": "^8.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/discord-rpc": "^4.0.11",
    "@types/node": "^26.1.0",
    "@types/prompts": "^2.4.9",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.65.0"
  }
}
